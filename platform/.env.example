# Copy to .env (or export) for production.

# Local dev default is a SQLite file (gamifydev.db). For production, point at Turso:
# DATABASE_URL=libsql://<your-db>.turso.io?authToken=<your-token>
DATABASE_URL=gamifydev.db

# Address to listen on.
ADDR=:8080

# Set to 1 behind HTTPS so session cookies are marked Secure.
SECURE_COOKIES=0
