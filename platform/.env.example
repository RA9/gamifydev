# Copy to .env (or export) for production.

# Local dev default is a SQLite file (gamifydev.db). For production, point at Turso:
# DATABASE_URL=libsql://<your-db>.turso.io?authToken=<your-token>
DATABASE_URL=gamifydev.db

# Address to listen on.
ADDR=:8080

# Set to 1 behind HTTPS so session cookies are marked Secure.
SECURE_COOKIES=0

# Optional Redis (for upcoming caching / rate limiting / live features). The app
# runs fine without it; set this to enable. Railway's Redis plugin provides it.
# REDIS_URL=redis://default:<password>@<host>:6379

# --- Server-side code execution (the Playground and server-run labs) ---
# Off by default. With docker-compose.yml, set CODE_EXEC=remote and point the
# app at the sandboxed execd service. See internal/runner/README.md.
# CODE_EXEC=remote
# CODE_EXEC_SANDBOX_URL=http://execd:9090
#
# Shared secret between the app and execd. Generate: openssl rand -hex 32
# EXEC_TOKEN=

# For a SINGLE-container local dev run (no execd), you can instead use the
# in-process executor. Only safe locally, and only when `bwrap` is on PATH in a
# deployed environment — otherwise the app refuses to enable it.
# CODE_EXEC=local
# PYTHON=python3

